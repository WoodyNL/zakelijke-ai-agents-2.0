# Publieke Supabase-waarden (staan ook in de client-bundle)
SUPABASE_PROJECT_ID=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_URL=
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_URL=

# Geheimen — alleen server-side. In productie staan deze in de Lovable-secrets;
# lokaal moet je ze hier zelf invullen, anders faalt het contactformulier.
# Supabase Dashboard > Project Settings > API > service_role key
SUPABASE_SERVICE_ROLE_KEY=
# Resend Dashboard > API Keys
RESEND_API_KEY=
